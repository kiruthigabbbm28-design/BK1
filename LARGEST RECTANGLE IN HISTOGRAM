class Solution:
    def largestRectangleArea(self, heights: List[int]) -> int:
        stack = [] # Stores indices
        max_area = 0
        # Adding a 0 at the end forces the stack to clear at the final step
        heights.append(0)
        
        for i, h in enumerate(heights):
            # When we find a shorter bar, the bar at the top of the stack 
            # has found its right boundary
            while stack and heights[stack[-1]] >= h:
                height = heights[stack.pop()]
                # If stack is empty, the width extends to the very beginning
                width = i if not stack else i - stack[-1] - 1
                max_area = max(max_area, height * width)
            
            stack.append(i)
            
        # Optional: remove the 0 if you need to keep the original input clean
        heights.pop()
        return max_area
