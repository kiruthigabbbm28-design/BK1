import math

class Solution:
    def getPermutation(self, n: int, k: int) -> str:
        # Convert k to 0-indexed for easier math
        k -= 1
        numbers = [str(i) for i in range(1, n + 1)]
        res = []
        
        # Precompute factorial for (n-1) to start
        fact = math.factorial(n - 1)
        
        for i in range(n - 1, 0, -1):
            # Index of the current number to pick
            idx = k // fact
            res.append(numbers.pop(idx))
            
            # Update k and the factorial for the next position
            k %= fact
            fact //= i
            
        # Add the last remaining number
        res.append(numbers[0])
        return "".join(res)
