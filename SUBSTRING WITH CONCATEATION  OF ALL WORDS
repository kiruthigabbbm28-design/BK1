from collections import Counter

class Solution:
    def findSubstring(self, s: str, words: List[str]) -> List[int]:
        if not s or not words:
            return []
            
        word_len = len(words[0])
        word_count = len(words)
        total_len = word_len * word_count
        word_freq = Counter(words)
        results = []
        
        # We only need to run the sliding window word_len times 
        # to cover all possible starting alignments.
        for i in range(word_len):
            left = i
            right = i
            current_freq = Counter()
            count = 0
            
            # Slide the window to the right in increments of word_len
            while right + word_len <= len(s):
                word = s[right : right + word_len]
                right += word_len
                
                if word in word_freq:
                    current_freq[word] += 1
                    count += 1
                    
                    # If we have more of 'word' than required, 
                    # shrink window from the left.
                    while current_freq[word] > word_freq[word]:
                        left_word = s[left : left + word_len]
                        current_freq[left_word] -= 1
                        count -= 1
                        left += word_len
                    
                    # If window contains exactly the right number of words
                    if count == word_count:
                        results.append(left)
                else:
                    # Found a word not in 'words', reset the window
                    current_freq.clear()
                    count = 0
                    left = right
                    
        return results
